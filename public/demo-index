<style>
:root{
  --primary:#0ea5e9;
  --secondary:#38bdf8;
  --accent:#06b6d4;
  --dark:#020617;
  --dark2:#0f172a;
  --dark3:#1e293b;
  --light:#f8fafc;
  --text:#cbd5e1;
  --white:#ffffff;
  --success:#10b981;

  --gradient-1:linear-gradient(135deg,#0ea5e9,#06b6d4,#14b8a6);
  --gradient-2:linear-gradient(135deg,#1e3a8a,#0ea5e9,#14b8a6);
  --glass:rgba(255,255,255,0.08);
  --glass-border:rgba(255,255,255,0.18);

  --radius-sm:12px;
  --radius-md:20px;
  --radius-lg:30px;
  --radius-xl:40px;

  --shadow-sm:0 8px 25px rgba(0,0,0,.12);
  --shadow-md:0 20px 60px rgba(0,0,0,.18);
  --shadow-lg:0 35px 90px rgba(0,0,0,.30);

  --container:1280px;
  --transition:all .35s ease;
}

/* Reset */
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:'Inter',sans-serif;
  background:var(--dark);
  color:var(--white);
  line-height:1.7;
  overflow-x:hidden;
}

a{
  text-decoration:none;
  color:inherit;
}

img{
  max-width:100%;
  display:block;
}

button,
input,
select{
  font-family:inherit;
}

.container{
  width:min(var(--container), calc(100% - 40px));
  margin:auto;
}

/* Background blobs */
.bg-blobs{
  position:fixed;
  inset:0;
  z-index:-2;
  overflow:hidden;
  pointer-events:none;
}

.blob{
  position:absolute;
  border-radius:50%;
  filter:blur(100px);
  opacity:.18;
}

.blob-1{
  width:500px;
  height:500px;
  top:-120px;
  left:-120px;
  background:#0ea5e9;
}

.blob-2{
  width:650px;
  height:650px;
  right:-200px;
  top:20%;
  background:#14b8a6;
}

.blob-3{
  width:450px;
  height:450px;
  bottom:-100px;
  left:25%;
  background:#8b5cf6;
}

/* Utility */
.section{
  padding:110px 0;
}

.section-header{
  text-align:center;
  margin-bottom:70px;
}

.section-badge{
  display:inline-block;
  padding:8px 18px;
  border-radius:999px;
  background:rgba(14,165,233,.12);
  border:1px solid rgba(14,165,233,.25);
  color:#7dd3fc;
  font-size:12px;
  font-weight:700;
  letter-spacing:2px;
  text-transform:uppercase;
  margin-bottom:18px;
}

.section-title{
  font-size:clamp(34px,5vw,64px);
  font-weight:900;
  line-height:1.1;
  margin-bottom:18px;
}

.section-title span{
  background:var(--gradient-1);
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
}

.section-subtitle{
  max-width:760px;
  margin:auto;
  color:var(--text);
  font-size:18px;
}

/* Glass Card */
.glass{
  background:var(--glass);
  border:1px solid var(--glass-border);
  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);
  box-shadow:var(--shadow-md);
}

/* Buttons */
.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  padding:14px 28px;
  border:none;
  border-radius:999px;
  font-size:14px;
  font-weight:700;
  letter-spacing:.5px;
  cursor:pointer;
  transition:var(--transition);
}

.btn-primary{
  background:var(--gradient-1);
  color:#fff;
  box-shadow:0 15px 35px rgba(14,165,233,.35);
}

.btn-primary:hover{
  transform:translateY(-3px) scale(1.02);
  box-shadow:0 25px 50px rgba(14,165,233,.45);
}

.btn-outline{
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.18);
  color:#fff;
}

.btn-outline:hover{
  background:rgba(255,255,255,.14);
  transform:translateY(-3px);
}

/* Header */
.header{
  position:fixed;
  top:0;
  left:0;
  width:100%;
  z-index:1000;
  transition:var(--transition);
}

.header.scrolled{
  background:rgba(2,6,23,.82);
  backdrop-filter:blur(20px);
  border-bottom:1px solid rgba(255,255,255,.08);
}

.navbar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:18px 0;
}

.logo-wrap{
  display:flex;
  align-items:center;
  gap:14px;
}

.logo-img{
  width:48px;
  height:48px;
  border-radius:14px;
  object-fit:cover;
  display:none;
}

.logo-text{
  font-size:24px;
  font-weight:900;
  letter-spacing:.5px;
}

.logo-text span{
  background:var(--gradient-1);
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
}

.nav-links{
  display:flex;
  align-items:center;
  gap:10px;
}

.nav-links a{
  padding:10px 18px;
  border-radius:999px;
  font-size:14px;
  font-weight:600;
  color:#e2e8f0;
  transition:var(--transition);
}

.nav-links a:hover{
  background:rgba(255,255,255,.08);
}

.nav-actions{
  display:flex;
  align-items:center;
  gap:12px;
}

.mobile-toggle{
  display:none;
  width:46px;
  height:46px;
  border-radius:14px;
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.1);
  color:#fff;
  font-size:20px;
  cursor:pointer;
}

.mobile-menu{
  position:fixed;
  top:80px;
  left:20px;
  right:20px;
  background:rgba(2,6,23,.96);
  border:1px solid rgba(255,255,255,.08);
  backdrop-filter:blur(20px);
  border-radius:24px;
  padding:24px;
  display:none;
  flex-direction:column;
  gap:14px;
  z-index:999;
}

.mobile-menu.active{
  display:flex;
}

.mobile-menu a{
  padding:12px 16px;
  border-radius:12px;
  color:#e2e8f0;
}

.mobile-menu a:hover{
  background:rgba(255,255,255,.06);
}

/* Hero */
.hero{
  position:relative;
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:140px 0 80px;
  overflow:hidden;
}
.hero{
  background-size:cover !important;
  background-position:center center !important;
  background-repeat:no-repeat !important;
  transform:none !important;
  transition:none !important;
}

.hero-bg{
  position:absolute;
  inset:0;
  z-index:-1;
  background:
    radial-gradient(circle at top right,
      rgba(14,165,233,.18),
      transparent 45%),
    radial-gradient(circle at bottom left,
      rgba(20,184,166,.15),
      transparent 45%),
    linear-gradient(135deg,
      rgba(2,6,23,.95),
      rgba(15,23,42,.92),
      rgba(30,41,59,.90));
}

#heroVideo{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  display:none;
  z-index:-2;
}
.hero{
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.hero::after{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(
    180deg,
    rgba(2,6,23,.55),
    rgba(2,6,23,.92)
  );
  z-index:-1;
}

.hero-grid{
  display:flex;
  justify-content:center;
  align-items:center;
  text-align:center;
  width:100%;
}

.hero-content{
  max-width:1100px;
  width:100%;
  margin:0 auto;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
}

.hero-badge{
  display:inline-flex;
  align-items:center;
  gap:10px;
  padding:10px 18px;
  border-radius:999px;
  background:rgba(14,165,233,.10);
  border:1px solid rgba(14,165,233,.22);
  color:#7dd3fc;
  font-size:12px;
  font-weight:700;
  letter-spacing:2px;
  text-transform:uppercase;
  margin-bottom:24px;
}

.hero-title{
  font-size:clamp(44px,7vw,78px);
  font-weight:500;
  line-height:1.08;
  margin-bottom:24px;
  text-shadow:0 4px 16px rgba(0,0,0,0.5);
  color:#ffffff;
  text-align:center;
  max-width:1200px;
  margin-left:auto;
  margin-right:auto;
}

.hero-title .gradient{
  background:var(--gradient-1);
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
}

.hero-text{
  font-size:20px;
  line-height:1.75;
  color:#ffffff !important;
  max-width:1100px;
  margin-bottom:34px;
  font-weight:500;
  text-shadow:0 2px 10px rgba(0,0,0,0.55);
  min-height:auto;
  transition:none !important;
}

.hero-buttons{
  display:flex;
  flex-wrap:wrap;
  gap:14px;
  margin-bottom:42px;
}

/* Search Card */
.search-card{
  padding:30px;
  border-radius:32px;
}

.search-title{
  font-size:22px;
  font-weight:800;
  margin-bottom:8px;
}

.search-subtitle{
  color:#cbd5e1;
  font-size:14px;
  margin-bottom:24px;
}

.search-form{
  display:grid;
  gap:14px;
}

.search-form input,
.search-form select{
  width:100%;
  height:52px;
  border-radius:14px;
  border:1px solid rgba(255,255,255,.10);
  background:rgba(255,255,255,.06);
  color:#fff;
  padding:0 16px;
  outline:none;
}

.search-form input::placeholder{
  color:#94a3b8;
}

.search-form select option{
  color:#000;
}

/* Stats */
.hero-stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:18px;
  margin-top:30px;
}

.stat-card{
  padding:22px;
  border-radius:22px;
  text-align:center;
}

.stat-number{
  font-size:30px;
  font-weight:900;
  background:var(--gradient-1);
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
}

.stat-label{
  font-size:12px;
  color:#94a3b8;
  margin-top:6px;
  text-transform:uppercase;
  letter-spacing:1px;
}
/* =========================================================
   FEATURES SECTION
========================================================= */
.features{
  position:relative;
}

.features-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:28px;
}

.feature-card{
  padding:36px 30px;
  border-radius:28px;
  position:relative;
  overflow:hidden;
  transition:var(--transition);
}

.feature-card::before{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(
    135deg,
    rgba(14,165,233,.06),
    rgba(20,184,166,.03),
    transparent
  );
  pointer-events:none;
}

.feature-card:hover{
  transform:translateY(-8px);
  box-shadow:0 30px 80px rgba(0,0,0,.25);
}

.feature-icon{
  width:64px;
  height:64px;
  border-radius:20px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:26px;
  background:var(--gradient-1);
  color:#fff;
  margin-bottom:22px;
  box-shadow:0 18px 40px rgba(14,165,233,.30);
}

.feature-card h3{
  font-size:22px;
  font-weight:800;
  margin-bottom:12px;
}

.feature-card p{
  color:var(--text);
  font-size:15px;
}
/* =========================================================
   MEMBERS SLIDER
========================================================= */
.members-slider{
  position:relative;
  width:100%;
  overflow:hidden;
  padding:10px 0 30px;
}

.members-track{
  display:flex;
  gap:24px;
  width:max-content;
  animation:membersScroll 60s linear infinite reverse;
}

.members-track:hover{
  animation-play-state:paused;
}

.member-card{
  width:220px;
  flex-shrink:0;
  text-align:center;
  padding:24px 18px;
  border-radius:28px;
}

.member-card img{
  width:110px;
  height:110px;
  border-radius:50%;
  object-fit:cover;
  margin:0 auto 16px;
  border:4px solid rgba(14,165,233,.25);
  box-shadow:0 10px 25px rgba(0,0,0,.25);
}

.member-card h3{
  font-size:18px;
  font-weight:800;
  margin-bottom:6px;
  color:#ffffff;
}

.member-card p{
  font-size:13px;
  color:#94a3b8;
  line-height:1.6;
}

@keyframes membersScroll{
  from{
    transform:translateX(-50%);
  }
  to{
    transform:translateX(0);
  }
}

@media (max-width:640px){
  .member-card{
    width:180px;
    padding:20px 14px;
  }

  .member-card img{
    width:90px;
    height:90px;
  }

  .member-card h3{
    font-size:16px;
  }
}
/* =========================================================
   HERITAGE SECTION
========================================================= */
.heritage{
  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.02),
      rgba(255,255,255,.01)
    );
}

.heritage-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:50px;
  align-items:center;
}

.heritage-image{
  position:relative;
}

.heritage-image img{
  width:100%;
  border-radius:32px;
  box-shadow:var(--shadow-lg);
  border:1px solid rgba(255,255,255,.08);
}

.heritage-content h2{
  font-size:clamp(34px,5vw,60px);
  font-weight:900;
  line-height:1.1;
  margin-bottom:20px;
}

.heritage-content h2 span{
  background:var(--gradient-1);
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
}

.heritage-content p{
  color:var(--text);
  font-size:17px;
  margin-bottom:18px;
}

.heritage-list{
  margin:28px 0;
  display:grid;
  gap:14px;
}

.heritage-item{
  display:flex;
  align-items:flex-start;
  gap:14px;
  color:#e2e8f0;
}

.heritage-item i{
  color:#22c55e;
  margin-top:4px;
}

/* =========================================================
   DYNAMIC VILLA SECTIONS
========================================================= */
#villaSections{
  position:relative;
}

.villa-wrapper{
  padding:80px 0;
}

.villa-wrapper:nth-child(even){
  background:rgba(255,255,255,.015);
}

.villa-section{
  width:min(var(--container), calc(100% - 40px));
  margin:auto;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:60px;
  align-items:center;
}

.villa-section.reverse{
  direction:rtl;
}

.villa-section.reverse > *{
  direction:ltr;
}

.villa-img img{
  width:100%;
  border-radius:32px;
  box-shadow:var(--shadow-lg);
  border:1px solid rgba(255,255,255,.08);
}

.villa-text h2{
  font-size:clamp(34px,5vw,56px);
  font-weight:900;
  line-height:1.1;
  margin-bottom:20px;
}

.villa-text p{
  color:var(--text);
  font-size:17px;
  line-height:1.9;
}

/* =========================================================
   HIGHLIGHTS CARDS
========================================================= */
.highlights{
  background:
    radial-gradient(circle at top right,
      rgba(14,165,233,.06),
      transparent 45%);
}

.highlight-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:28px;
}

.card{
  padding:36px 30px;
  border-radius:28px;
  position:relative;
  overflow:hidden;
  transition:var(--transition);
}

.card::before{
  content:"";
  position:absolute;
  top:0;
  left:0;
  right:0;
  height:4px;
  background:var(--gradient-1);
}

.card:hover{
  transform:translateY(-10px);
  box-shadow:0 30px 80px rgba(0,0,0,.28);
}

.card h3{
  font-size:22px;
  font-weight:800;
  margin-bottom:12px;
}

.card p{
  color:var(--text);
  font-size:15px;
  line-height:1.8;
}

/* Scroll Animation */
.animate{
  opacity:0;
  transform:translateY(40px);
  transition:all .8s ease;
}

.animate.show{
  opacity:1;
  transform:translateY(0);
}

/* =========================================================
   TIMELINE SECTION
========================================================= */
.timeline{
  position:relative;
}

.timeline-wrapper{
  max-width:900px;
  margin:auto;
  position:relative;
}

.timeline-wrapper::before{
  content:"";
  position:absolute;
  top:0;
  bottom:0;
  left:50%;
  width:2px;
  background:linear-gradient(
    to bottom,
    transparent,
    rgba(14,165,233,.6),
    transparent
  );
  transform:translateX(-50%);
}

.timeline-item{
  position:relative;
  width:50%;
  padding:20px 40px;
}

.timeline-item:nth-child(odd){
  left:0;
  text-align:right;
}

.timeline-item:nth-child(even){
  left:50%;
}

.timeline-dot{
  position:absolute;
  top:32px;
  width:18px;
  height:18px;
  border-radius:50%;
  background:var(--gradient-1);
  box-shadow:0 0 0 6px rgba(14,165,233,.15);
}

.timeline-item:nth-child(odd) .timeline-dot{
  right:-9px;
}

.timeline-item:nth-child(even) .timeline-dot{
  left:-9px;
}

.timeline-card{
  padding:28px;
  border-radius:24px;
}

.timeline-year{
  display:inline-block;
  padding:6px 14px;
  border-radius:999px;
  background:rgba(14,165,233,.12);
  color:#7dd3fc;
  font-size:12px;
  font-weight:700;
  letter-spacing:1px;
  margin-bottom:14px;
}

.timeline-card h3{
  font-size:22px;
  font-weight:800;
  margin-bottom:10px;
}

.timeline-card p{
  color:var(--text);
}
.member-role-badge{
  display:inline-block;
  margin-top:10px;
  padding:6px 12px;
  border-radius:999px;
  background:rgba(14,165,233,0.15);
  border:1px solid rgba(14,165,233,0.30);
  color:#7dd3fc;
  font-size:11px;
  font-weight:700;
  letter-spacing:0.5px;
  text-transform:uppercase;
}

/* =========================================================
   SECTION OPENING TAGS
========================================================= */
</style>
