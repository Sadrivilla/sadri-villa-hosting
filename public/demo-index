/* =========================================================
   SIMPLE COUNTER ANIMATION
========================================================= */
function animateCounter(el, targetText) {
  if (!el || !targetText) return;

  const clean = String(targetText).replace(/[^\d]/g, "");
  const target = parseInt(clean, 10);

  if (isNaN(target)) {
    el.textContent = targetText;
    return;
  }

  const suffix = targetText.replace(clean, "");
  let current = 0;
  const increment = Math.max(1, Math.ceil(target / 80));

  function update() {
    current += increment;

    if (current >= target) {
      el.textContent = target + suffix;
      return;
    }

    el.textContent = current + suffix;
    requestAnimationFrame(update);
  }

  update();
}

/* Animate hero counters when visible */
const statObserver = new IntersectionObserver(
  (entries, observer) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;

      const numberEl =
        entry.target.querySelector(".stat-number");

      if (numberEl && !numberEl.dataset.animated) {
        numberEl.dataset.animated = "true";
        animateCounter(
          numberEl,
          numberEl.textContent.trim()
        );
      }

      observer.unobserve(entry.target);
    });
  },
  { threshold: 0.4 }
);

