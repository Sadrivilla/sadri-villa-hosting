<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Admin Dashboard – Sadri Villa</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
<link rel="apple-touch-icon" sizes="180x180" href="/favicon.png">
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
body{font-family:'Inter',sans-serif;background:#f1f5f9;margin:0}
.heading{font-family:'Playfair Display',serif}
.track.scrolling{animation:scroll linear infinite}
.track:hover{animation-play-state:paused}
@keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
#profileCard.show{display:block!important}

/* Prevent oversized charts */
.chart-wrapper{
  position:relative;
  height:280px;
  width:100%;
}

.chart-wrapper canvas{
  width:100% !important;
  height:100% !important;
  display:block;
}
</style>
</head>
<body>
<div class="min-h-screen flex">
  <!-- Sidebar -->
  <aside class="hidden lg:flex lg:flex-col w-80 bg-white border-r border-slate-200 shadow-xl">
    <div class="p-8 border-b border-slate-100">
      <div class="flex items-center gap-3">
        <img id="siteLogo" class="h-10 hidden">
        <div>
          <h1 class="heading text-4xl font-bold text-emerald-900">Sadri Villa</h1>
          <p class="text-gray-500 mt-2 text-sm">Heritage Management Dashboard</p>
        </div>
      </div>
    </div>

    <nav class="flex-1 p-6 space-y-2 overflow-y-auto">
      <a href="admin.html" class="flex items-center gap-3 px-4 py-3 rounded-2xl bg-emerald-100 text-emerald-900 font-semibold">🏠 Dashboard</a>
      <a href="admin-shajra.html" class="flex items-center gap-3 px-4 py-3 rounded-2xl hover:bg-slate-100">🌳 Add/Edit Member</a>
      <a href="admin-logo.html" class="flex items-center gap-3 px-4 py-3 rounded-2xl hover:bg-slate-100">🖼 Logo</a>
      <a href="admin-hero.html" class="flex items-center gap-3 px-4 py-3 rounded-2xl hover:bg-slate-100">🎯 Hero</a>
      <a href="admin-slider.html" class="flex items-center gap-3 px-4 py-3 rounded-2xl hover:bg-slate-100">🖼 Slider</a>
      <a href="admin-villa-sections.html" class="flex items-center gap-3 px-4 py-3 rounded-2xl hover:bg-slate-100">📝 Index Sections</a>
      <a href="admin-list.html" class="flex items-center gap-3 px-4 py-3 rounded-2xl hover:bg-slate-100">👤 Admin List</a>
      <a href="add-admin.html" class="flex items-center gap-3 px-4 py-3 rounded-2xl hover:bg-slate-100">➕ Add Admin</a>
      <a href="team-admin.html" class="flex items-center gap-3 px-4 py-3 rounded-2xl hover:bg-slate-100">🏛 Historical Monument</a>
      <a href="admin-profile.html" class="flex items-center gap-3 px-4 py-3 rounded-2xl hover:bg-slate-100">📋 Profile Fields</a>
      <a href="admin-logs.html" class="flex items-center gap-3 px-4 py-3 rounded-2xl hover:bg-slate-100">📝 Logs</a>
      <a href="dashboard.html" class="flex items-center gap-3 px-4 py-3 rounded-2xl hover:bg-slate-100">👥 User Dashboard</a>
    </nav>

    <div class="p-6">
      <div class="bg-gradient-to-r from-emerald-900 to-emerald-700 text-white rounded-3xl p-5">
        <p class="text-emerald-100 text-sm">Storage Used</p>
        <p class="text-3xl font-bold mt-1">68%</p>
        <div class="mt-4 h-2 bg-white/20 rounded-full overflow-hidden">
          <div class="h-full w-2/3 bg-amber-300"></div>
        </div>
      </div>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="flex-1 p-6 lg:p-8">
    <!-- Top Bar -->
    <header class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
      <div>
        <h2 class="heading text-5xl font-bold text-emerald-950">Dashboard Overview</h2>
        <p class="text-gray-600 mt-2" id="welcomeName">Sadri Villa – Admin</p>
      </div>

      <div class="flex items-center gap-4">
        <div id="pendingAlertIcon" class="relative cursor-pointer hidden" onclick="location.href='admin-approval-requests.html'">
          <span class="text-2xl">🔔</span>
          <span id="pendingBadge" class="absolute -top-2 -right-2 bg-red-600 text-white text-xs font-bold px-1.5 py-0.5 rounded-full">0</span>
        </div>

        <div class="relative">
          <img id="profilePhoto" src="https://cdn-icons-png.flaticon.com/512/4140/4140048.png" class="w-12 h-12 rounded-full object-cover border-2 border-sky-400 cursor-pointer">
          <div id="profileCard" class="hidden absolute top-14 right-0 bg-white rounded-xl shadow-2xl w-56 overflow-hidden border border-slate-200 z-50">
            <a href="profile.html" class="block px-4 py-3 hover:bg-slate-50">Profile</a>
            <a href="change-password.html" class="block px-4 py-3 hover:bg-slate-50">Change Password</a>
            <a href="#" id="logoutBtn" class="block px-4 py-3 hover:bg-slate-50 text-red-600">Logout</a>
          </div>
        </div>
      </div>
    </header>

    <!-- Hero -->
    <section class="bg-gradient-to-r from-emerald-950 via-emerald-900 to-emerald-700 text-white rounded-[2rem] p-10 shadow-2xl mb-8">
      <h3 class="heading text-4xl font-bold text-amber-300">Welcome Back, Admin</h3>
      <p class="mt-4 max-w-3xl text-emerald-100 leading-relaxed text-lg">
        Preserve the legacy of Sadri Villa by managing members, family lineage, heritage photos, timelines and visitor analytics.
      </p>
    </section>

    <!-- Statistics -->
    <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6 mb-8">
      <div class="bg-white rounded-3xl p-6 shadow-lg border border-slate-200">
        <p class="text-gray-500 text-sm">Total Users</p>
        <p class="text-4xl font-bold mt-2" id="totalUsers">—</p>
      </div>
      <div class="bg-white rounded-3xl p-6 shadow-lg border border-slate-200">
        <p class="text-gray-500 text-sm">Dashboard Views</p>
        <p class="text-4xl font-bold mt-2" id="pageViews">—</p>
      </div>
      <div onclick="location.href='admin-media.html'" class="bg-white rounded-3xl p-6 shadow-lg border border-slate-200 cursor-pointer hover:shadow-xl transition">
        <p class="text-gray-500 text-sm">Quick Access</p>
        <p class="text-2xl font-bold mt-2">🖼 Manage Site Media</p>
      </div>
    </section>

    <!-- Charts -->
    <section class="grid grid-cols-1 xl:grid-cols-3 gap-6 mb-8">
      <div class="bg-white rounded-3xl p-6 shadow-lg border border-slate-200">
        <h3 class="text-xl font-semibold mb-4">User Approval Status</h3>
        <div class="chart-wrapper"><canvas id="approvalChart"></canvas></div>
        <button onclick="showAllApprovals()" class="mt-4 px-4 py-2 bg-emerald-600 text-white rounded-xl">Show All</button>
      </div>
      <div class="bg-white rounded-3xl p-6 shadow-lg border border-slate-200">
        <h3 class="text-xl font-semibold mb-4">User Age Distribution</h3>
        <div class="chart-wrapper"><canvas id="ageChart"></canvas></div>
      </div>
      <div class="bg-white rounded-3xl p-6 shadow-lg border border-slate-200">
        <h3 class="text-xl font-semibold mb-4">Profile Completion</h3>
        <div class="chart-wrapper"><canvas id="profileChart"></canvas></div>
        <button onclick="showAllProfiles()" class="mt-4 px-4 py-2 bg-amber-500 text-white rounded-xl">Show All</button>
      </div>
    </section>

    <!-- Gallery -->
    <section class="bg-white rounded-3xl p-6 shadow-lg border border-slate-200">
      <h3 class="text-xl font-semibold mb-4">Heritage Gallery</h3>
      <div class="overflow-hidden">
        <div class="track flex gap-5 w-max" id="galleryTrack"></div>
      </div>
    </section>
  </main>
</div>

<!-- Image Modal -->
<div class="fixed inset-0 bg-black/60 hidden items-center justify-center z-50" id="imgModal">
  <div class="bg-white p-5 rounded-3xl max-w-3xl mx-4">
    <img id="modalImg" class="max-h-[80vh] rounded-2xl">
  </div>
</div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getAnalytics, logEvent } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-analytics.js";
import { getAuth, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
import {
  getFirestore,
  collection,
  getDocs,
  query,
  where,
  onSnapshot,
  doc,
  getDoc,
  setDoc,
  updateDoc,
  increment
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

const app = initializeApp({
  apiKey: "AIzaSyC7gkT4F_dRJpWfef12y6cwV3F2PTMJ6fY",
  authDomain: "sadri-villa-14c06.firebaseapp.com",
  projectId: "sadri-villa-14c06"
});

const analyticsApp = initializeApp({
  apiKey: "AIzaSyDuQxBCm0eEYthCscPbryU4VfNfanwdvw8",
  authDomain: "sadri-villa-hosting.firebaseapp.com",
  projectId: "sadri-villa-hosting",
  storageBucket: "sadri-villa-hosting.firebasestorage.app",
  messagingSenderId: "81185723978",
  appId: "1:81185723978:web:f8bd536f6c69589f4538b3",
  measurementId: "G-ENLHWXPEEZ"
}, "analyticsApp");

const auth = getAuth(app);
const db = getFirestore(app);
const analytics = getAnalytics(analyticsApp);

let approvalChartInstance = null;
let ageChartInstance = null;
let profileChartInstance = null;
let cachedUsers = [];
let unsubscribeSiteSettings = null;

onAuthStateChanged(auth, async (user) => {
  if (!user) {
    location.href = 'login.html';
    return;
  }

  const snap = await getDoc(doc(db, 'users', user.uid));
  if (!snap.exists()) {
    location.href = 'dashboard.html';
    return;
  }

  const data = snap.data();
  if (data.role !== 'admin') {
    alert('Access denied');
    location.href = 'dashboard.html';
    return;
  }

  document.getElementById('welcomeName').innerText = 'Sadri Villa – Welcome ' + (data.fullName || 'Admin');

  if (data.profilePhoto) {
    document.getElementById('profilePhoto').src = data.profilePhoto + '?v=' + Date.now();
  }

  await trackPageViewCount();
  await loadDashboard();

  logEvent(analytics, 'page_view', {
    page_title: 'Admin Dashboard',
    page_location: window.location.href
  });

  listenPendingRealtime();
  initProfileMenu();
  initModal();
  await subscribeSiteSettings();
});

async function subscribeSiteSettings() {
  if (unsubscribeSiteSettings) return;

  unsubscribeSiteSettings = onSnapshot(doc(db, 'siteSettings', 'home'), (snap) => {
    if (!snap.exists()) return;

    const data = snap.data();
    const logo = document.getElementById('siteLogo');

    if (data.logo?.url) {
      logo.src = data.logo.url + '?v=' + Date.now();
      logo.classList.remove('hidden');
    } else {
      logo.classList.add('hidden');
    }

    const imgs = (data.sliderImages || []).filter(i => i.enabled !== false);
    const track = document.getElementById('galleryTrack');
    track.innerHTML = '';
    track.classList.remove('scrolling');

    const list = imgs.length > 1 ? [...imgs, ...imgs] : imgs;

    list.forEach((item) => {
      const img = document.createElement('img');
      img.src = item.url;
      img.className = 'w-80 h-56 object-cover rounded-3xl shadow-lg cursor-pointer hover:scale-[1.02] transition';
      img.onclick = () => {
        document.getElementById('modalImg').src = item.url;
        document.getElementById('imgModal').classList.remove('hidden');
        document.getElementById('imgModal').classList.add('flex');
      };
      track.appendChild(img);
    });

    if (imgs.length > 1) {
      track.classList.add('scrolling');
      requestAnimationFrame(() => {
        const width = track.scrollWidth / 2;
        track.style.animationDuration = (width / 80) + 's';
      });
    }
  });
}

async function loadDashboard() {
  const snap = await getDocs(collection(db, 'users'));
  cachedUsers = snap.docs.map(d => d.data());

  document.getElementById('totalUsers').innerText = cachedUsers.length;

  renderApprovalChart();
  renderAgeChart();
  renderProfileChart();
  await loadPageViews();
}

async function loadPageViews() {
  const snap = await getDoc(doc(db, 'analytics', 'admin_dashboard'));
  if (snap.exists()) {
    document.getElementById('pageViews').innerText = snap.data().views || 0;
  }
}

async function trackPageViewCount() {
  const ref = doc(db, 'analytics', 'admin_dashboard');
  try {
    await updateDoc(ref, { views: increment(1) });
  } catch {
    await setDoc(ref, { views: 1 });
  }
}

function renderApprovalChart() {
  const approved = cachedUsers.filter(u => u.approved === true).length;
  const pending = cachedUsers.length - approved;
  if (approvalChartInstance) approvalChartInstance.destroy();
  approvalChartInstance = new Chart(document.getElementById('approvalChart'), {
    type: 'doughnut',
    data: {
      labels: ['Approved', 'Pending'],
      datasets: [{ data: [approved, pending] }]
    },
    options: { responsive: true, maintainAspectRatio: false }
  });
}

function renderAgeChart() {
  const young = cachedUsers.filter(u => u.age && u.age < 30).length;
  const adult = cachedUsers.filter(u => u.age >= 30 && u.age < 50).length;
  const senior = cachedUsers.filter(u => u.age >= 50).length;
  if (ageChartInstance) ageChartInstance.destroy();
  ageChartInstance = new Chart(document.getElementById('ageChart'), {
    type: 'bar',
    data: {
      labels: ['Young', 'Adult', 'Senior'],
      datasets: [{ data: [young, adult, senior] }]
    },
    options: { responsive: true, maintainAspectRatio: false }
  });
}

function renderProfileChart() {
  const completed = cachedUsers.filter(u => u.phone && u.email).length;
  const incomplete = cachedUsers.length - completed;
  if (profileChartInstance) profileChartInstance.destroy();
  profileChartInstance = new Chart(document.getElementById('profileChart'), {
    type: 'bar',
    data: {
      labels: ['Completed', 'Incomplete'],
      datasets: [{ data: [completed, incomplete] }]
    },
    options: { responsive: true, maintainAspectRatio: false }
  });
}

function listenPendingRealtime() {
  const q = query(collection(db, 'users'), where('approved', '==', false));
  onSnapshot(q, (snapshot) => {
    let count = 0;
    snapshot.forEach((docSnap) => {
      const data = docSnap.data();
      if (data.approvalReminder === true) count++;
    });

    const bell = document.getElementById('pendingAlertIcon');
    const badge = document.getElementById('pendingBadge');
    bell.classList.remove('hidden');

    if (count > 0) {
      badge.innerText = count;
      badge.style.display = 'block';
    } else {
      badge.style.display = 'none';
    }
  });
}

window.showAllApprovals = () => {
  location.href = 'admin-approval-requests.html';
};

window.showAllProfiles = () => {
  alert('Profile list feature coming soon');
};

function initModal() {
  document.getElementById('imgModal').onclick = () => {
    document.getElementById('imgModal').classList.add('hidden');
    document.getElementById('imgModal').classList.remove('flex');
  };
}

function initProfileMenu() {
  document.getElementById('profilePhoto').onclick = (e) => {
    e.stopPropagation();
    document.getElementById('profileCard').classList.toggle('show');
    document.getElementById('profileCard').classList.toggle('hidden');
  };

  document.addEventListener('click', () => {
    const card = document.getElementById('profileCard');
    card.classList.remove('show');
    card.classList.add('hidden');
  });

  document.getElementById('profileCard').addEventListener('click', (e) => e.stopPropagation()); 

  document.getElementById('logoutBtn').onclick = async (e) => {
    e.preventDefault();
    await signOut(auth);
    location.href = 'login.html';
  };
}
</script>
</body>
</html>
